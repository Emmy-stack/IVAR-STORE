# =============================================================================
# IVAR STORE: Environment Variables Configuration
# =============================================================================

# Supabase Project URL and Public Anon Key (Required for Supabase Auth, DB, and Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Used strictly server-side for admin verification, never exposed client-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clerk Authentication Keys (From https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Authorized Admin Email (Must strictly match socialmeda03@gmail.com)
ADMIN_EMAIL=socialmeda03@gmail.com

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
